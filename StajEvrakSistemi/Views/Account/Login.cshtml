@{
    ViewData["Title"] = "Sisteme Giriş";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white text-center">
                    <h4>Staj Evrak Yönetim Sistemi</h4>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label">Kurumsal E-Posta</label>
                            <input type="email" name="email" class="form-control" placeholder="ornek@kocaeli.edu.tr" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Şifre</label>
                            <input type="password" name="password" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">Giriş Yap</button>
                    </form>

                    <hr />
                    <div class="small text-muted">
                        <strong>Test Hesapları:</strong><br />
                        Öğrenci: <code>ogrenci@kocaeli.edu.tr</code> | Şifre: <code>123456</code><br />
                        Komisyon (Admin): <code>admin@kocaeli.edu.tr</code> | Şifre: <code>admin123</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>